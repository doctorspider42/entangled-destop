<?xml version="1.0" encoding="utf-8"?>
<!--
  `entangled install windows` (ADR-0008 §4): an unattended Windows 10/11
  installation onto the first virtio-blk disk.

  This file is the root of a small answer disc on the AHCI controller, beside
  the untouched Windows ISO. Windows Setup finds it by itself (the implicit
  search covers the root of every read-only removable volume) and loads the
  virtio-win drivers from the same disc's $WinPEDriver$ folder, both into
  Windows PE — which is what lets it see the virtio disk at all — and into the
  installed system.

  The installer fills in the placeholders (each name between at signs):
    IMAGE_INDEX    the edition, as its index in install.wim/install.esd
    COMPUTER_NAME  the VM name, cut to what NetBIOS allows
    TIMEZONE       a Windows time zone name ("UTC" unless asked otherwise)
    PE_COMMANDS    RunSynchronous commands for Windows PE (Windows 11's
                   hardware checks, which this machine cannot yet pass)

  No product key: the edition is chosen by index and the installed system is
  simply not activated. The account is local, `entangled`, without a
  password, and logs on automatically; its first logon turns hibernation off
  and powers the machine off, which is how the installer knows it finished.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend"
          xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
@PE_COMMANDS@      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>EFI</Type>
              <Size>260</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>MSR</Type>
              <Size>16</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Format>FAT32</Format>
              <Label>System</Label>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>3</PartitionID>
              <Format>NTFS</Format>
              <Label>Windows</Label>
              <Letter>C</Letter>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>
      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/INDEX</Key>
              <Value>@IMAGE_INDEX@</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
        </OSImage>
      </ImageInstall>
      <UserData>
        <AcceptEula>true</AcceptEula>
        <!-- Consumer media refuse an answer file without this element
             ("Windows cannot read the <ProductKey> setting"); empty, the
             edition comes from /IMAGE/INDEX and nothing is asked. -->
        <ProductKey>
          <Key></Key>
          <WillShowUI>Never</WillShowUI>
        </ProductKey>
      </UserData>
    </component>
  </settings>
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>@COMPUTER_NAME@</ComputerName>
      <TimeZone>@TIMEZONE@</TimeZone>
    </component>
    <!-- The machine's RTC keeps UTC, as Linux expects (machine_x86::rtc), and
         Windows reads the RTC as local time unless told otherwise. -->
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add HKLM\SYSTEM\CurrentControlSet\Control\TimeZoneInformation /v RealTimeIsUniversal /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>entangled</Name>
            <Group>Administrators</Group>
            <Password>
              <Value></Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>entangled</Username>
        <Password>
          <Value></Value>
          <PlainText>true</PlainText>
        </Password>
      </AutoLogon>
      <FirstLogonCommands>
        <!-- Hibernation off: a resumed hiberfil after the machine's devices
             changed (the install's discs gone) is a bugcheck waiting. -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>powercfg /hibernate off</CommandLine>
        </SynchronousCommand>
        <!-- The end of the installation: an ACPI power-off the installer
             waits for. -->
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine>shutdown /s /t 5 /c "Entangled: installation finished"</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>

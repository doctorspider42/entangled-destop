+// Entangled: the vsync timer exists from StartDevice to StopDevice and runs
+// only while dxgkrnl has the interrupt enabled (ControlInterrupt).
+VOID VioGpuDod::StartVSync(VOID)
+{
+    PAGED_CODE();
+
+    if (m_VSyncTimer == NULL)
+    {
+        // High resolution: an ordinary kernel timer expires on the system
+        // clock tick (15.6 ms by default), which is the very grid a vsync
+        // has to get the desktop off.
+        m_VSyncTimer = ExAllocateTimer(VSyncTimerCallback, this, EX_TIMER_HIGH_RESOLUTION);
+    }
+}
+
+VOID VioGpuDod::StopVSync(VOID)
+{
+    PAGED_CODE();
+
+    InterlockedExchange(&m_VSyncEnabled, 0);
+    if (m_VSyncTimer != NULL)
+    {
+        // Cancels, and waits for a callback that is running to return.
+        ExDeleteTimer(m_VSyncTimer, TRUE, TRUE, NULL);
+        m_VSyncTimer = NULL;
+    }
+}

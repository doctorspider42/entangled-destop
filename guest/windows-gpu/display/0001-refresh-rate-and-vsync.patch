+// Entangled: the refresh rate of the EDID's preferred (first) detailed
+// timing, pixel clock over total pixels. 60 Hz when there is none or it is
+// not credible.
+VOID VioGpuAdapter::GetRefreshRate(_Out_ ULONG *pNumerator, _Out_ ULONG *pDenominator)
+{
+    PAGED_CODE();
+
+    *pNumerator = 60;
+    *pDenominator = 1;
+
+    PBYTE edid = GetEdidData();
+    if (edid == NULL)
+    {
+        return;
+    }
+    PBYTE dtd = edid + 54;
+    ULONG clock = ((ULONG)dtd[0] | ((ULONG)dtd[1] << 8)) * 10000;
+    ULONG htotal = (dtd[2] | ((dtd[4] & 0xF0) << 4)) + (dtd[3] | ((dtd[4] & 0x0F) << 8));
+    ULONG vtotal = (dtd[5] | ((dtd[7] & 0xF0) << 4)) + (dtd[6] | ((dtd[7] & 0x0F) << 8));
+    if (clock == 0 || htotal == 0 || vtotal == 0)
+    {
+        return;
+    }
+    // In millihertz: the exact ratio does not fit the 32-bit rationals a
+    // video signal carries once it is multiplied by a mode's height.
+    ULONGLONG total = (ULONGLONG)htotal * vtotal;
+    ULONG mhz = (ULONG)(((ULONGLONG)clock * 1000 + total / 2) / total);
+    if (mhz < 24000 || mhz > 240000)
+    {
+        return;
+    }
+    *pNumerator = mhz;
+    *pDenominator = 1000;
+}

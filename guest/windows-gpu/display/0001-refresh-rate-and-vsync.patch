+// Entangled: the vsync.
+//
+// A display-only driver without DxgkDdiControlInterrupt and DxgkDdiGetScanLine
+// gets a vsync dxgkrnl simulates, and that one ends on the system clock tick:
+// DWM then composes every 15.6 ms or every 31.25 ms, never at the display's
+// rate. This driver has no display hardware to interrupt it either (virtio-gpu
+// has no vblank), so the vsync is a high-resolution timer at the EDID's rate,
+// reported the way a vblank interrupt would be: DxgkCbNotifyInterrupt under
+// the interrupt's lock, then the DPC.
+
+LONGLONG VioGpuDod::VSyncPeriod100ns(VOID) const
+{
+    return (10000000LL * m_RefreshDenominator + m_RefreshNumerator / 2) / m_RefreshNumerator;
+}
+
+LONGLONG VioGpuDod::Now100ns(VOID) const
+{
+    LARGE_INTEGER freq;
+    LARGE_INTEGER now = KeQueryPerformanceCounter(&freq);
+    return (now.QuadPart / freq.QuadPart) * 10000000LL + (now.QuadPart % freq.QuadPart) * 10000000LL / freq.QuadPart;
+}
+
+// One shot at the next point of a grid one period apart, not a periodic timer:
+// a periodic one is re-armed from the clock interrupt that expired it, so every
+// period comes out up to a clock interrupt long (measured: 17.6 ms for 60 Hz,
+// 36 interrupts of 488 us where 34.1 were asked for). Against a grid the
+// lateness of one vsync is not carried into the next. Only the timer's callback
+// and the enable that starts it call this, never both at once.
+VOID VioGpuDod::ArmVSync(LONGLONG Now)
+{
+    LONGLONG period = VSyncPeriod100ns();
+    m_NextVSync += period;
+    if (m_NextVSync <= Now)
+    {
+        // Fell a whole period behind (a stalled vCPU): skip the missed ones.
+        m_NextVSync += ((Now - m_NextVSync) / period + 1) * period;
+    }
+    ExSetTimer(m_VSyncTimer, Now - m_NextVSync, 0, NULL);
+}
+
+NTSTATUS VioGpuDod::ControlInterrupt(_In_ CONST DXGK_INTERRUPT_TYPE InterruptType, _In_ BOOLEAN EnableInterrupt)
+{
+    if (InterruptType != DXGK_INTERRUPT_DISPLAYONLY_VSYNC)
+    {
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    if (m_VSyncTimer == NULL)
+    {
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+    if (EnableInterrupt)
+    {
+        if (InterlockedExchange(&m_VSyncEnabled, 1) == 0)
+        {
+            LONGLONG now = Now100ns();
+            m_NextVSync = now;
+            ArmVSync(now);
+        }
+    }
+    else
+    {
+        if (InterlockedExchange(&m_VSyncEnabled, 0) != 0)
+        {
+            ExCancelTimer(m_VSyncTimer, NULL);
+        }
+    }
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS VioGpuDod::GetScanLine(_Inout_ DXGKARG_GETSCANLINE *pGetScanLine)
+{
+    // There is no raster. The answer is where one would be, this far after
+    // the last vsync: the blank first (a twentieth of the frame), then the
+    // lines in order.
+    LONGLONG period = VSyncPeriod100ns();
+    LONGLONG last = m_LastVSync;
+    LONGLONG since = last ? (Now100ns() - last) % period : 0;
+    LONGLONG blank = period / 20;
+    UINT height = m_CurrentMode.DispInfo.Height ? m_CurrentMode.DispInfo.Height : NOM_HEIGHT_SIZE;
+
+    if (since < blank)
+    {
+        pGetScanLine->InVerticalBlank = TRUE;
+        pGetScanLine->ScanLine = 0;
+    }
+    else
+    {
+        pGetScanLine->InVerticalBlank = FALSE;
+        pGetScanLine->ScanLine = (UINT)((since - blank) * height / (period - blank));
+    }
+    return STATUS_SUCCESS;
+}
+
+BOOLEAN VioGpuDod::VSyncNotify(_In_opt_ PVOID Context)
+{
+    VioGpuDod *pVioGpuDod = reinterpret_cast<VioGpuDod *>(Context);
+    DXGKARGCB_NOTIFY_INTERRUPT_DATA NotifyInterrupt = {};
+    NotifyInterrupt.InterruptType = DXGK_INTERRUPT_DISPLAYONLY_VSYNC;
+    NotifyInterrupt.DisplayOnlyVsync.VidPnTargetId = 0;
+    pVioGpuDod->m_DxgkInterface.DxgkCbNotifyInterrupt(pVioGpuDod->m_DxgkInterface.DeviceHandle, &NotifyInterrupt);
+    pVioGpuDod->m_DxgkInterface.DxgkCbQueueDpc(pVioGpuDod->m_DxgkInterface.DeviceHandle);
+    return TRUE;
+}
+
+VOID VioGpuDod::VSyncTick(VOID)
+{
+    if (!m_VSyncEnabled || !IsDriverActive())
+    {
+        return;
+    }
+    LONGLONG now = Now100ns();
+    InterlockedExchange64(&m_LastVSync, now);
+    ArmVSync(now);
+
+    if (IsHardwareInit())
+    {
+        BOOLEAN ret = FALSE;
+        m_DxgkInterface.DxgkCbSynchronizeExecution(m_DxgkInterface.DeviceHandle, VSyncNotify, this, 0, &ret);
+    }
+}
+
+VOID VioGpuDod::VSyncTimerCallback(_In_ PEX_TIMER Timer, _In_opt_ PVOID Context)
+{
+    UNREFERENCED_PARAMETER(Timer);
+    VioGpuDod *pVioGpuDod = reinterpret_cast<VioGpuDod *>(Context);
+    if (pVioGpuDod)
+    {
+        pVioGpuDod->VSyncTick();
+    }
+}

+                m_pShared = new (PagedPool) BYTE[m_sharedSize];
+                if (m_pShared != NULL)
+                {
+                    RtlZeroMemory(m_pShared, m_sharedSize);
+                }
+            }
+            dstBase = (PBYTE)m_pShared;
+            dstLimit = m_sharedSize;
+            dstShared = TRUE;
+        }
+        if (dstBase != NULL && srcBase != NULL &&
+            (SIZE_T)(dstY + height - 1) * dstPitch + (SIZE_T)(dstX + width) * 4 <= dstLimit &&
+            (SIZE_T)(srcY + height - 1) * srcPitch + (SIZE_T)(srcX + width) * 4 <= srcLimit)

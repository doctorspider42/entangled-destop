+++ b/viogpu/viogpu3d/viogpu_allocation.h
@@ -85,6 +85,7 @@
         PETHREAD AccessThread;
         ULONGLONG Generation;
         bool Writing;
+        bool ReaderAcknowledged;
         bool Revoked;
     };
     // The allocation may outlive both the original device and process.

+}
+
+NTSTATUS VioGpuAllocation::AccessGpuShare(ULONG operation, ULONGLONG *generation)
+{
+    PAGED_CODE();
+    if (operation < ENTANGLED_WDDM_BEGIN_WRITE || operation > ENTANGLED_WDDM_ABORT_ACCESS)
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+    const bool writing = operation == ENTANGLED_WDDM_BEGIN_WRITE;
+    if (writing && PsGetCurrentProcess() != m_shareOwner)
+    {
+        return STATUS_ACCESS_DENIED;
+    }
+    auto *share = static_cast<GpuShare *>(InterlockedCompareExchangePointer(&m_gpuShare, NULL, NULL));
+    if (share == NULL)
+    {
+        return STATUS_NOT_FOUND;
+    }
+
+    const auto current = PsGetCurrentThread();
+    PETHREAD retired = NULL;
+    NTSTATUS status = STATUS_SUCCESS;
+    ExAcquireFastMutex(&share->AccessLock);
+    if (share->AccessThread != NULL && PsIsThreadTerminating(share->AccessThread))
+    {
+        // The GPU may still be touching this image. Do not hand it out again.
+        share->Revoked = true;
+        retired = share->AccessThread;
+        share->AccessThread = NULL;
+    }
+    if (share->Revoked)
+    {
+        status = STATUS_CANCELLED;
+    }
+    else if (operation == ENTANGLED_WDDM_END_ACCESS || operation == ENTANGLED_WDDM_ABORT_ACCESS)
+    {
+        if (share->AccessThread != current)
+        {
+            status = STATUS_ACCESS_DENIED;
+        }
+        else
+        {
+            retired = share->AccessThread;
+            share->AccessThread = NULL;
+            if (operation == ENTANGLED_WDDM_ABORT_ACCESS)
+            {
+                share->Revoked = true;
+            }
+            else
+            {
+                if (share->Writing && ++share->Generation == 0)
+                {
+                    ++share->Generation;
+                }
+                *generation = share->Generation;
+            }
+        }
+    }
+    else if (share->AccessThread != NULL)
+    {
+        status = STATUS_RETRY;
+    }
+    else if (!writing && share->Generation == 0)
+    {
+        status = STATUS_DEVICE_NOT_READY;
+    }
+    else if (!writing && *generation == share->Generation)
+    {
+        status = STATUS_NO_MORE_ENTRIES;
+    }
+    else
+    {
+        ObReferenceObject(current);
+        share->AccessThread = current;
+        share->Writing = writing;
+        *generation = share->Generation;
+    }
+    ExReleaseFastMutex(&share->AccessLock);
+    if (retired != NULL)
+    {
+        ObDereferenceObject(retired);
+    }
+    return status;
 }
 #endif


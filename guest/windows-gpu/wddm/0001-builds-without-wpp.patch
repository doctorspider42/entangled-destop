diff --git a/viogpu/viogpu3d/trace.h b/viogpu/viogpu3d/trace.h
index 3f3925f..e47262b 100644
--- a/viogpu/viogpu3d/trace.h
+++ b/viogpu/viogpu3d/trace.h
@@ -1,7 +1,15 @@
 #pragma once
 #include "kdebugprint.h"
 
+// Entangled: upstream forces its debug mode on (DBG 1, messages to a kernel
+// debugger). Ours is off, and on only in a diagnostic build:
+// ENTANGLED_SERIAL_TRACE=<level> sends the driver's messages up to that level
+// to COM1, which a VM's log carries - the only view into a kernel driver in a
+// guest with no debugger attached.
+#if defined(ENTANGLED_SERIAL_TRACE)
 #define DBG 1
+#define COM_DEBUG 1
+#endif
 
 #ifndef TRACE_LEVEL_INFORMATION
 #define TRACE_LEVEL_NONE        0   // Tracing is not on
@@ -33,6 +41,12 @@
 
 #define WPP_INIT_TRACING(driver, regpath)  InitializeDebugPrints(driver, regpath);
 #define WPP_CLEANUP(driver)
+#elif defined(ENTANGLED_NO_WPP)
+// Entangled: built without the WDK's MSBuild integration, so without WPP.
+#define DbgPrint(Level, MSG)
+#define VioGpuDbgBreak()
+#define WPP_INIT_TRACING(driver, regpath)
+#define WPP_CLEANUP(driver)
 #else
 //#define DbgPrint(level, line) {};
 

+#ifdef ENTANGLED_WDDM2_LAB
+// Called in the process carrying the token, with the DXGK allocation pinned.
+NTSTATUS VioGpuAllocation::BindGpuShare(HANDLE userToken)
+{
+    PAGED_CODE();
+    if (m_shareOwner != PsGetCurrentProcess())
+    {
+        return STATUS_ACCESS_DENIED;
+    }
+    if (InterlockedCompareExchangePointer(&m_gpuShare, NULL, NULL) != NULL)
+    {
+        return STATUS_ALREADY_COMMITTED;
+    }
+
+    PKEVENT event;
+    NTSTATUS status = ObReferenceObjectByHandle(userToken, SYNCHRONIZE, *ExEventObjectType,
+                                               UserMode, reinterpret_cast<PVOID *>(&event), NULL);
+    if (!NT_SUCCESS(status))
+    {
+        return status;
+    }
+
+    auto *share = new (NonPagedPoolNx) GpuShare{};
+    if (share == NULL)
+    {
+        ObDereferenceObject(event);
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+
+    status = ObOpenObjectByPointer(event, OBJ_KERNEL_HANDLE, NULL, SYNCHRONIZE,
+                                   *ExEventObjectType, KernelMode, &share->Token);
+    ObDereferenceObject(event);
+    if (NT_SUCCESS(status))
+    {
+        UNICODE_STRING name = RTL_CONSTANT_STRING(ENTANGLED_GPU_KERNEL_NAME);
+        OBJECT_ATTRIBUTES attributes;
+        InitializeObjectAttributes(&attributes, &name, OBJ_KERNEL_HANDLE | OBJ_CASE_INSENSITIVE, NULL, NULL);
+        IO_STATUS_BLOCK io = {};
+        status = ZwOpenFile(&share->RenderFile, FILE_READ_DATA | FILE_WRITE_DATA | SYNCHRONIZE,
+                            &attributes, &io, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                            FILE_SYNCHRONOUS_IO_NONALERT);
+        if (NT_SUCCESS(status))
+        {
+            ENTANGLED_GPU_BLOB_TOKEN request = {reinterpret_cast<ULONG_PTR>(share->Token)};
+            status = ZwDeviceIoControlFile(share->RenderFile, NULL, NULL, NULL, &io,
+                                           IOCTL_ENTANGLED_GPU_PIN_WDDM_BLOB,
+                                           &request, sizeof(request), NULL, 0);
+            if (NT_SUCCESS(status))
+            {
+                if (InterlockedCompareExchangePointer(&m_gpuShare, share, NULL) == NULL)
+                {
+                    return STATUS_SUCCESS;
+                }
+                status = STATUS_ALREADY_COMMITTED;
+            }
+            ZwClose(share->RenderFile);
+        }
+        ZwClose(share->Token);
+    }
+    delete share;
+    return status;
+}
+
+NTSTATUS VioGpuAllocation::OpenGpuShare(HANDLE *userToken)
+{
+    PAGED_CODE();
+    auto *share = static_cast<GpuShare *>(InterlockedCompareExchangePointer(&m_gpuShare, NULL, NULL));
+    if (share == NULL)
+    {
+        return STATUS_NOT_FOUND;
+    }
+    // The caller's DXGK allocation reference authorizes this duplicate into
+    // its process. The source remains a private kernel handle.
+    return ZwDuplicateObject(NtCurrentProcess(), share->Token, NtCurrentProcess(),
+                             userToken, SYNCHRONIZE, 0, 0);
+}

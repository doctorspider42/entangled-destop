+#ifdef ENTANGLED_WDDM2_LAB
+NTSTATUS VioGpuAdapter::CalibrateGpuClock(DXGKARG_CALIBRATEGPUCLOCK *calibration)
+{
+    // See WDDM_CLOCK_CONFIG_OFFSET in the Entangled virtio-gpu protocol.
+    constexpr unsigned versionOffset = 0x100;
+    constexpr unsigned frequencyOffset = 0x108;
+    constexpr unsigned ticksOffset = 0x110;
+    constexpr UINT32 version1 = 0x43470001;
+    if (!IsHardwareInit())
+        return STATUS_DEVICE_NOT_READY;
+
+    auto readConfig = [this](unsigned offset) {
+        UINT32 value = 0;
+        virtio_get_config(&m_VioDev, offset, &value, sizeof(value));
+        return value;
+    };
+    if (readConfig(versionOffset) != version1)
+        return STATUS_NOT_SUPPORTED;
+
+    const UINT64 frequencyLow = readConfig(frequencyOffset);
+    const UINT64 frequency = (static_cast<UINT64>(readConfig(frequencyOffset + 4)) << 32) | frequencyLow;
+    if (!frequency)
+        return STATUS_NOT_SUPPORTED;
+
+    for (unsigned attempt = 0; attempt != 3; ++attempt)
+    {
+        const LONGLONG before = KeQueryPerformanceCounter(nullptr).QuadPart;
+        const UINT32 high = readConfig(ticksOffset + 4);
+        const UINT32 low = readConfig(ticksOffset);
+        const UINT32 highAgain = readConfig(ticksOffset + 4);
+        const LONGLONG after = KeQueryPerformanceCounter(nullptr).QuadPart;
+        if (high == highAgain && after >= before && readConfig(versionOffset) == version1)
+        {
+            calibration->GpuFrequency = frequency;
+            calibration->GpuClockCounter = (static_cast<UINT64>(high) << 32) | low;
+            calibration->CpuClockCounter = before + (after - before) / 2;
+            return STATUS_SUCCESS;
+        }
+    }
+    return STATUS_DEVICE_NOT_READY;
+}
+#endif

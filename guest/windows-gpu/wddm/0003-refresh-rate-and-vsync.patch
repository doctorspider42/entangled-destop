+ULONG VioGpuVidPN::RefreshMilliHz(void)
+{
+    PAGED_CODE();
+
+    PBYTE edid = GetEdidData(0);
+    if (edid == NULL)
+    {
+        return 60000;
+    }
+    // The first detailed timing descriptor: pixel clock over total pixels.
+    PBYTE dtd = edid + 54;
+    ULONG clock = ((ULONG)dtd[0] | ((ULONG)dtd[1] << 8)) * 10000;
+    ULONG htotal = (dtd[2] | ((dtd[4] & 0xF0) << 4)) + (dtd[3] | ((dtd[4] & 0x0F) << 8));
+    ULONG vtotal = (dtd[5] | ((dtd[7] & 0xF0) << 4)) + (dtd[6] | ((dtd[7] & 0x0F) << 8));
+    if (clock == 0 || htotal == 0 || vtotal == 0)
+    {
+        return 60000;
+    }
+    ULONGLONG total = (ULONGLONG)htotal * vtotal;
+    ULONG mhz = (ULONG)(((ULONGLONG)clock * 1000 + total / 2) / total);
+    if (mhz < 24000 || mhz > 240000)
+    {
+        return 60000;
+    }
+    return mhz;
+}

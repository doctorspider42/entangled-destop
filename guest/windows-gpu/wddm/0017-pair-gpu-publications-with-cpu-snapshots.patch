+// Map locks may be held here; AccessGpuShare never takes a map lock.
+void VioGpuAllocation::NoteGpuShareCpuWrite(bool producerSnapshot)
+{
+    auto *share = static_cast<GpuShare *>(InterlockedCompareExchangePointer(&m_gpuShare, NULL, NULL));
+    if (share == NULL)
+    {
+        return;
+    }
+    ExAcquireFastMutex(&share->AccessLock);
+    if (share->PairedWithCpu)
+    {
+        if (producerSnapshot && share->Writing && share->AccessThread == PsGetCurrentThread())
+        {
+            share->CpuSnapshotWritten = true;
+        }
+        else
+        {
+            share->Revoked = true;
+        }
+    }
+    ExReleaseFastMutex(&share->AccessLock);
+}

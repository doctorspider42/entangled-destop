diff --git a/viogpu/viogpu3d/entangled_wddm2.cpp b/viogpu/viogpu3d/entangled_wddm2.cpp
new file mode 100644
index 0000000..d6f4a94
--- /dev/null
+++ b/viogpu/viogpu3d/entangled_wddm2.cpp
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#include "helper.h"
+#include "entangled_wddm2.h"
+
+#ifdef ENTANGLED_WDDM2_LAB
+
+template <typename T> static const T *QueryInput(const DXGKARG_QUERYADAPTERINFO *query)
+{
+    return query->InputDataSize >= sizeof(T) ? static_cast<const T *>(query->pInputData) : nullptr;
+}
+
+template <typename T> static T *QueryOutput(const DXGKARG_QUERYADAPTERINFO *query)
+{
+    return query->OutputDataSize >= sizeof(T) ? static_cast<T *>(query->pOutputData) : nullptr;
+}
+
+NTSTATUS EntangledQueryWddm2(const DXGKARG_QUERYADAPTERINFO *query, HANDLE adapter)
+{
+    switch (query->Type)
+    {
+        case DXGKQAITYPE_HISTORYBUFFERPRECISION:
+        {
+            const auto *index = QueryInput<DXGK_QUERYHISTORYBUFFERPRECISIONIN>(query);
+            auto *precision = QueryOutput<DXGKARG_HISTORYBUFFERPRECISION>(query);
+            if (!index || index->PhysicalAdapterIndex != 0 || !precision)
+                return STATUS_INVALID_PARAMETER;
+            precision->PrecisionBits = 0;  // No GPU timestamps in WDDM history buffers.
+            return STATUS_SUCCESS;
+        }
+        case DXGKQAITYPE_DISPLAY_DRIVERCAPS_EXTENSION:
+        {
+            auto *caps = QueryOutput<DXGK_DISPLAY_DRIVERCAPS_EXTENSION>(query);
+            if (!caps)
+                return STATUS_BUFFER_TOO_SMALL;
+            caps->Value = 0;
+            return STATUS_SUCCESS;
+        }
+        case DXGKQAITYPE_PHYSICALADAPTERCAPS:
+        {
+            const auto *index = QueryInput<DXGK_QUERYPHYSICALADAPTERCAPSIN>(query);
+            constexpr SIZE_T required = offsetof(DXGK_PHYSICALADAPTERCAPS, Flags) + sizeof(DXGK_PHYSICALADAPTERFLAGS);
+            if (!index || index->PhysicalAdapterIndex != 0 || !query->pOutputData || query->OutputDataSize < required)
+                return STATUS_INVALID_PARAMETER;
+            DXGK_PHYSICALADAPTERCAPS caps = {};
+            caps.NumExecutionNodes = 1;
+            caps.DxgkPhysicalAdapterHandle = adapter;
+            caps.Flags.GpuMmuSupported = 1;
+            RtlZeroMemory(query->pOutputData, query->OutputDataSize);
+            RtlCopyMemory(query->pOutputData, &caps, required);
+            return STATUS_SUCCESS;
+        }
+        case DXGKQAITYPE_GPUMMUCAPS:
+        {
+            const auto *index = QueryInput<DXGK_QUERYGPUMMUCAPSIN>(query);
+            auto *caps = QueryOutput<DXGK_GPUMMUCAPS>(query);
+            if (!index || index->PhysicalAdapterIndex != 0 || !caps)
+                return STATUS_INVALID_PARAMETER;
+            *caps = {};
+            caps->CacheCoherentMemorySupported = 1;
+            caps->PageTableUpdateMode = DXGK_PAGETABLEUPDATE_CPU_VIRTUAL;
+            caps->VirtualAddressBitCount = ENTANGLED_GPU_VA_BITS;
+            caps->PageTableLevelCount = ENTANGLED_GPU_PAGE_TABLE_LEVELS;
+            return STATUS_SUCCESS;
+        }
+        case DXGKQAITYPE_PAGETABLELEVELDESC:
+        {
+            const auto *index = QueryInput<DXGK_QUERYPAGETABLELEVELDESCIN>(query);
+            auto *desc = QueryOutput<DXGK_PAGE_TABLE_LEVEL_DESC>(query);
+            if (!index || index->PhysicalAdapterIndex != 0 || index->LevelIndex >= ENTANGLED_GPU_PAGE_TABLE_LEVELS || !desc)
+                return STATUS_INVALID_PARAMETER;
+            *desc = {};
+            desc->PageTableIndexBitCount = ENTANGLED_GPU_PAGE_TABLE_INDEX_BITS;
+            desc->PageTableSizeInBytes = PAGE_SIZE;
+            return STATUS_SUCCESS;
+        }
+        case DXGKQAITYPE_QUERYSEGMENT4:
+        {
+            const auto *index = QueryInput<DXGK_QUERYSEGMENTIN4>(query);
+            auto *segments = QueryOutput<DXGK_QUERYSEGMENTOUT4>(query);
+            if (!index || index->PhysicalAdapterIndex != 0 || !segments)
+                return STATUS_INVALID_PARAMETER;
+            segments->NbSegment = 1;
+            if (!segments->pSegmentDescriptor)
+                return STATUS_SUCCESS;
+            if (segments->SegmentDescriptorStride < FIELD_OFFSET(DXGK_SEGMENTDESCRIPTOR4, NumInvalidMemoryRanges))
+                return STATUS_BUFFER_TOO_SMALL;
+            segments->PagingBufferSegmentId = 1;
+            segments->PagingBufferSize = 10 * PAGE_SIZE;
+            segments->PagingBufferPrivateDataSize = 0;
+            RtlZeroMemory(segments->pSegmentDescriptor, segments->SegmentDescriptorStride);
+            auto *segment = reinterpret_cast<DXGK_SEGMENTDESCRIPTOR4 *>(segments->pSegmentDescriptor);
+            segment->BaseAddress.QuadPart = 0xC0000000;
+            segment->Flags.Aperture = 1;
+            segment->Flags.CacheCoherent = 1;
+            segment->Flags.DirectFlip = 1;
+            segment->Size = ENTANGLED_GPU_APERTURE_SIZE;
+            segment->CommitLimit = ENTANGLED_GPU_APERTURE_SIZE;
+            return STATUS_SUCCESS;
+        }
+        default:
+            return STATUS_NOT_SUPPORTED;
+    }
+}
+
+NTSTATUS EntangledUpdatePageTable(const DXGK_BUILDPAGINGBUFFER_UPDATEPAGETABLE &update)
+{
+    // VidMm has removed the parent mapping before an eviction notification.
+    // There are no cached walks or retained mappings to invalidate.
+    if (update.Flags.NotifyEviction || update.NumPageTableEntries == 0)
+        return STATUS_SUCCESS;
+    if (update.UpdateMode != DXGK_PAGETABLEUPDATE_CPU_VIRTUAL || update.Flags.Use64KBPages)
+        return STATUS_NOT_SUPPORTED;
+    if (update.PageTableLevel >= ENTANGLED_GPU_PAGE_TABLE_LEVELS ||
+        update.StartIndex >= ENTANGLED_GPU_PAGE_TABLE_ENTRIES ||
+        update.NumPageTableEntries > ENTANGLED_GPU_PAGE_TABLE_ENTRIES - update.StartIndex ||
+        !update.PageTableAddress.CpuVirtual || !update.pPageTableEntries)
+        return STATUS_INVALID_PARAMETER;
+
+    auto *table = static_cast<DXGK_PTE *>(update.PageTableAddress.CpuVirtual);
+    for (UINT i = 0; i < update.NumPageTableEntries; ++i)
+        table[update.StartIndex + i] = update.pPageTableEntries[update.Flags.Repeat ? 0 : i];
+    return STATUS_SUCCESS;
+}
+
+#endif
diff --git a/viogpu/viogpu3d/entangled_wddm2.h b/viogpu/viogpu3d/entangled_wddm2.h
new file mode 100644
index 0000000..057282b
--- /dev/null
+++ b/viogpu/viogpu3d/entangled_wddm2.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#pragma once
+
+#ifdef ENTANGLED_WDDM2_LAB
+
+// VidMm allocates one system page for each software page table. Keeping
+// DXGK_PTE intact preserves each entry's segment, address and access flags.
+constexpr UINT ENTANGLED_GPU_PAGE_TABLE_LEVELS = 4;
+constexpr UINT ENTANGLED_GPU_PAGE_TABLE_INDEX_BITS = 8;
+constexpr UINT ENTANGLED_GPU_PAGE_TABLE_ENTRIES = 1u << ENTANGLED_GPU_PAGE_TABLE_INDEX_BITS;
+constexpr UINT ENTANGLED_GPU_VA_BITS = 12 + ENTANGLED_GPU_PAGE_TABLE_LEVELS * ENTANGLED_GPU_PAGE_TABLE_INDEX_BITS;
+constexpr SIZE_T ENTANGLED_GPU_APERTURE_SIZE = 1ull << 30;
+static_assert(sizeof(DXGK_PTE) * ENTANGLED_GPU_PAGE_TABLE_ENTRIES == PAGE_SIZE, "one system page per GPU page table");
+
+NTSTATUS EntangledQueryWddm2(const DXGKARG_QUERYADAPTERINFO *query, HANDLE adapter);
+NTSTATUS EntangledUpdatePageTable(const DXGK_BUILDPAGINGBUFFER_UPDATEPAGETABLE &update);
+
+#endif

+static NTSTATUS APIENTRY EntangledSubmitCommandVirtual(HANDLE adapter, const DXGKARG_SUBMITCOMMANDVIRTUAL *args)
+{
+    auto *device = static_cast<VioGpuAdapter *>(adapter);
+    if (!device->IsDriverActive())
+        return STATUS_INVALID_PARAMETER;
+
+    // An empty scheduler packet has no GPU command bytes. Keep it ordered
+    // with the physical submissions on the same single execution node.
+    const bool empty = args->DmaBufferSize == 0;
+    if (!empty)
+    {
+        const auto *context = static_cast<const VioGpuContext *>(args->hContext);
+        DbgPrint(TRACE_LEVEL_ERROR, ("virtual DMA packet size=%u root=%u\n",
+                                    args->DmaBufferSize, context && context->HasRootPageTable()));
+    }
+    // For a rejected packet, retire the fence in order without reporting
+    // a successful execution interrupt. Dxgkrnl owns the device error.
+    DXGKARG_SUBMITCOMMAND marker = {};
+    marker.hContext = args->hContext;
+    marker.SubmissionFenceId = args->SubmissionFenceId;
+    const NTSTATUS status = device->commander.SubmitCommand(&marker, empty);
+    return empty && NT_SUCCESS(status) ? STATUS_SUCCESS : STATUS_INVALID_PARAMETER;

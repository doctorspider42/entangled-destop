+// Entangled (no virgl): the rectangles of a present, kept until the command
+// runs. More than the cap become their bounding box.
+#define ENTANGLED_MAX_BLT_RECTS 256
+
+void VioGpuCommand::SetBlt(VioGpuAllocation *src, VioGpuAllocation *dst, LONG dx, LONG dy, const RECT *rects, UINT count)
+{
+    PAGED_CODE();
+    if (count == 0 || rects == NULL)
+    {
+        return;
+    }
+    UINT kept = count > ENTANGLED_MAX_BLT_RECTS ? 1 : count;
+    m_bltRects = new (NonPagedPoolNx) RECT[kept];
+    if (m_bltRects == NULL)
+    {
+        return;
+    }
+    if (kept == count)
+    {
+        RtlCopyMemory(m_bltRects, rects, kept * sizeof(RECT));
+    }
+    else
+    {
+        RECT box = rects[0];
+        for (UINT i = 1; i < count; i++)
+        {
+            box.left = min(box.left, rects[i].left);
+            box.top = min(box.top, rects[i].top);
+            box.right = max(box.right, rects[i].right);
+            box.bottom = max(box.bottom, rects[i].bottom);
+        }
+        m_bltRects[0] = box;
+    }
+    m_bltCount = kept;
+    m_bltSrc = src;
+    m_bltDst = dst;
+    m_bltDx = dx;
+    m_bltDy = dy;
+}
+
 void VioGpuCommand::Run()
 {
     PAGED_CODE();
+    if (m_bltRects != NULL)
+    {
+        for (UINT i = 0; i < m_bltCount; i++)
+        {
+            const RECT *rect = &m_bltRects[i];
+            m_bltDst->CopyFrom(m_bltSrc,
+                               rect->left,
+                               rect->top,
+                               rect->left + m_bltDx,
+                               rect->top + m_bltDy,
+                               rect->right - rect->left,
+                               rect->bottom - rect->top);
+        }
+        delete[] m_bltRects;
+        m_bltRects = NULL;
+    }
     DbgPrint(TRACE_LEVEL_VERBOSE, ("<---> %s", __FUNCTION__));
 
     while (m_pCommand < m_pEnd)

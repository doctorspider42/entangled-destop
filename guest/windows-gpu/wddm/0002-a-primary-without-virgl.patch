+// Entangled (no virgl): a present, done here instead of on the host. Both
+// surfaces are four bytes a pixel with no padding between rows. The rectangle
+// is clipped to both; a surface that is not mapped (not in the aperture) is
+// left alone - the next present repaints it.
+void VioGpuAllocation::CopyFrom(VioGpuAllocation *src, LONG dstX, LONG dstY, LONG srcX, LONG srcY, LONG width, LONG height)
+{
+    PAGED_CODE();
+
+    if (dstX < 0)
+    {
+        width += dstX;
+        srcX -= dstX;
+        dstX = 0;
+    }
+    if (dstY < 0)
+    {
+        height += dstY;
+        srcY -= dstY;
+        dstY = 0;
+    }
+    if (srcX < 0)
+    {
+        width += srcX;
+        dstX -= srcX;
+        srcX = 0;
+    }
+    if (srcY < 0)
+    {
+        height += srcY;
+        dstY -= srcY;
+        srcY = 0;
+    }
+    width = min(width, (LONG)m_options.width - dstX);
+    width = min(width, (LONG)src->m_options.width - srcX);
+    height = min(height, (LONG)m_options.height - dstY);
+    height = min(height, (LONG)src->m_options.height - srcY);
+    if (width <= 0 || height <= 0)
+    {
+        return;
+    }
+
+    BOOLEAN copied = FALSE;
+    if (src != this)
+    {
+        // Always in address order, so two presents the other way round cannot
+        // deadlock.
+        VioGpuAllocation *first = (ULONG_PTR)this < (ULONG_PTR)src ? this : src;
+        VioGpuAllocation *second = first == this ? src : this;
+        ExAcquireFastMutex(&first->m_mapLock);
+        ExAcquireFastMutex(&second->m_mapLock);
+        SIZE_T dstPitch = (SIZE_T)m_options.width * 4;
+        SIZE_T srcPitch = (SIZE_T)src->m_options.width * 4;
+        if (m_pMapVa != NULL && src->m_pMapVa != NULL &&
+            (SIZE_T)(dstY + height) * dstPitch <= m_pageCount * PAGE_SIZE &&
+            (SIZE_T)(srcY + height) * srcPitch <= src->m_pageCount * PAGE_SIZE)
+        {
+            PBYTE to = (PBYTE)m_pMapVa + (SIZE_T)dstY * dstPitch + (SIZE_T)dstX * 4;
+            PBYTE from = (PBYTE)src->m_pMapVa + (SIZE_T)srcY * srcPitch + (SIZE_T)srcX * 4;
+            for (LONG row = 0; row < height; row++)
+            {
+                RtlCopyMemory(to, from, (SIZE_T)width * 4);
+                to += dstPitch;
+                from += srcPitch;
+            }
+            copied = TRUE;
+        }
+        ExReleaseFastMutex(&second->m_mapLock);
+        ExReleaseFastMutex(&first->m_mapLock);
+    }
+    if (!copied)
+    {
+        return;
+    }
+    m_adapter->ctrlQueue.TransferToHost2D(m_Id,
+                                          (ULONG)(((ULONGLONG)dstY * m_options.width + dstX) * 4),
+                                          (UINT)width,
+                                          (UINT)height,
+                                          (UINT)dstX,
+                                          (UINT)dstY);
+    if (m_adapter->vidpn.IsSource(this))
+    {
+        m_adapter->ctrlQueue.ResFlush(m_Id, (UINT)width, (UINT)height, (UINT)dstX, (UINT)dstY);
+    }
+}

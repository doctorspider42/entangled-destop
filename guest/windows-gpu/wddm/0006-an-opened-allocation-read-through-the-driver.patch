@@ -229,6 +233,95 @@ void VioGpuAllocation::FlushToScreen(UINT scan_id)
 // surfaces are four bytes a pixel with no padding between rows. The rectangle
 // is clipped to both; a surface that is not mapped (not in the aperture) is
 // left alone - the next present repaints it.
+// Entangled (no virgl): a surface one process draws and another shows - a
+// window's frame on its way to DWM. Windows refuses a lock of an allocation
+// the caller only opened (STATUS_INVALID_PARAMETER, whatever the flags), and
+// an allocation nothing renders with never enters the aperture, so the pages
+// are not mapped here either. The driver therefore keeps the pixels itself:
+// the producer writes them in (escape 0x903), whoever opened the allocation
+// reads them out (0x902). Both run in the caller's context, as an escape does.
+NTSTATUS VioGpuAllocation::CopyIn(PVOID user, SIZE_T size)
+{
+    PAGED_CODE();
+
+    NTSTATUS status = STATUS_SUCCESS;
+    if (size == 0 || size > (SIZE_T)m_options.width * m_options.height * 4)
+    {
+        return STATUS_BUFFER_OVERFLOW;
+    }
+    ExAcquireFastMutex(&m_mapLock);
+    if (m_pShared == NULL)
+    {
+        m_sharedSize = (SIZE_T)m_options.width * m_options.height * 4;
+        m_pShared = new (PagedPool) BYTE[m_sharedSize];
+    }
+    if (m_pShared == NULL)
+    {
+        status = STATUS_INSUFFICIENT_RESOURCES;
+    }
+    else
+    {
+        __try
+        {
+            ProbeForRead(user, size, 1);
+            RtlCopyMemory(m_pShared, user, size);
+            m_sharedWrites++;
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+            status = STATUS_ACCESS_VIOLATION;
+        }
+    }
+    ExReleaseFastMutex(&m_mapLock);
+    return status;
+}
+
+NTSTATUS VioGpuAllocation::CopyOut(PVOID user, SIZE_T size, ULONGLONG *seen)
+{
+    PAGED_CODE();
+
+    NTSTATUS status = STATUS_SUCCESS;
+    ExAcquireFastMutex(&m_mapLock);
+    // What a producer wrote, or else the pages themselves when they are
+    // mapped (a primary).
+    PVOID pixels = NULL;
+    if (m_pShared != NULL && size <= m_sharedSize)
+    {
+        // The same frame the caller already has: a compositor asks every
+        // time it draws the window.
+        if (*seen == m_sharedWrites)
+        {
+            ExReleaseFastMutex(&m_mapLock);
+            return STATUS_SUCCESS;
+        }
+        *seen = m_sharedWrites;
+        pixels = m_pShared;
+    }
+    else if (m_pMapVa != NULL && size <= m_pageCount * PAGE_SIZE)
+    {
+        pixels = m_pMapVa;
+    }
+    if (pixels == NULL || size == 0)
+    {
+        // Nothing drawn into it yet.
+        status = STATUS_DEVICE_NOT_READY;
+    }
+    else
+    {
+        __try
+        {
+            ProbeForWrite(user, size, 1);
+            RtlCopyMemory(user, pixels, size);
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+            status = STATUS_ACCESS_VIOLATION;
+        }
+    }
+    ExReleaseFastMutex(&m_mapLock);
+    return status;
+}

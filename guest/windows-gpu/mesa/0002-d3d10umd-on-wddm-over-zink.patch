    zink_copy_image_buffer(ctx, dst, src, x, 0, 0, trans->base.b.level, &trans->base.b.box, trans->base.b.usage);
 }
 
+bool
+zink_entangled_frame(struct pipe_context *pctx, struct pipe_resource *pbuf,
+                     struct pipe_resource *ptex, void **device,
+                     uint64_t *memory)
+{
+   struct zink_context *ctx = zink_context(pctx);
+   struct zink_resource *buf = zink_resource(pbuf);
+   struct zink_resource *tex = zink_resource(ptex);
+   struct pipe_box box;
+
+   /* A slab entry shares its memory with others: not a frame of its own. */
+   if (!buf->obj->bo->mem || zink_bo_get_offset(buf->obj->bo))
+      return false;
+   u_box_2d(0, 0, ptex->width0, ptex->height0, &box);
+   box.width = pbuf->width0;
+   box.x = 0;
+   {
+      /* The copy's box is the texture's; the barrier on the buffer reads
+       * x and width as a byte range, as a transfer's does. */
+      struct pipe_box image = box;
+
+      image.width = ptex->width0;
+      zink_resource_buffer_transfer_dst_barrier(ctx, buf, 0, pbuf->width0);
+      zink_copy_image_buffer(ctx, buf, tex, 0, 0, 0, 0, &image, 0);
+   }
+   *device = (void *)zink_screen(pctx->screen)->dev;
+   *memory = (uint64_t)(uintptr_t)buf->obj->bo->mem;
+   return true;
+}

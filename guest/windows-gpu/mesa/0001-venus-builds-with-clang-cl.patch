+
+/* A thread's high-resolution timer, in a fiber-local slot whose callback
+ * closes it when the thread ends. NO_TIMER marks a thread the system gave
+ * none (before Windows 10 1803): it sleeps the old way. */
+#define VN_NO_TIMER ((HANDLE)(intptr_t)-2)
+static INIT_ONCE vn_timer_once = INIT_ONCE_STATIC_INIT;
+static DWORD vn_timer_slot = FLS_OUT_OF_INDEXES;
+
+static void WINAPI
+vn_timer_release(void *data)
+{
+   if (data && data != VN_NO_TIMER)
+      CloseHandle(data);
+}
+
+/* The slot's callback is this DLL's code: a thread that outlives the DLL
+ * (it is unloaded, say by consent.exe after its UI drew through Direct3D)
+ * would end in an unloaded module. atexit in a DLL runs when it unloads;
+ * FlsFree runs the callback for every thread still holding a timer. */
+static void
+vn_timer_slot_free(void)
+{
+   if (vn_timer_slot != FLS_OUT_OF_INDEXES)
+      FlsFree(vn_timer_slot);
+   vn_timer_slot = FLS_OUT_OF_INDEXES;
+}
+
+static BOOL CALLBACK
+vn_timer_slot_init(PINIT_ONCE once, void *param, void **context)
+{
+   (void)once;
+   (void)param;
+   (void)context;
+   vn_timer_slot = FlsAlloc(vn_timer_release);
+   if (vn_timer_slot != FLS_OUT_OF_INDEXES && atexit(vn_timer_slot_free) != 0) {
+      /* No way to take the callback back at unload: go without timers. */
+      FlsFree(vn_timer_slot);
+      vn_timer_slot = FLS_OUT_OF_INDEXES;
+   }
+   return TRUE;
+}
+
+static HANDLE
+vn_thread_timer(void)
+{
+   InitOnceExecuteOnce(&vn_timer_once, vn_timer_slot_init, NULL, NULL);
+   if (vn_timer_slot == FLS_OUT_OF_INDEXES)
+      return VN_NO_TIMER;
+   HANDLE timer = FlsGetValue(vn_timer_slot);
+   if (!timer) {
+      timer = CreateWaitableTimerExW(NULL, NULL,
+                                     CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                     TIMER_ALL_ACCESS);
+      if (!timer)
+         timer = VN_NO_TIMER;
+      FlsSetValue(vn_timer_slot, timer);
+   }
+   return timer;
+}
+#endif
+
+void
+vn_sleep_us(uint32_t usecs)
+{
+#ifdef _WIN32
+   HANDLE timer = vn_thread_timer();
+   if (timer != VN_NO_TIMER) {
+      LARGE_INTEGER due;
+      due.QuadPart = -(LONGLONG)usecs * 10; /* relative, 100 ns units */
+      if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE) &&
+          WaitForSingleObject(timer, INFINITE) == WAIT_OBJECT_0)
+         return;
+   }
+#endif
+   os_time_sleep(usecs);
+}

+/* Where the window's client area is on the desktop, in physical pixels, when
+ * nothing can cover it: the foreground window, not minimised, its client area
+ * the swapchain's size and entirely on the primary screen. */
+static bool
+wsi_win32_overlay_place(struct wsi_win32_swapchain *chain, int32_t *x, int32_t *y)
+{
+   HWND root = GetAncestor(chain->wnd, GA_ROOT);
+   if (!root || GetForegroundWindow() != root || IsIconic(root))
+      return false;
+   DPI_AWARENESS_CONTEXT old =
+      SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+   RECT client;
+   POINT origin = { 0, 0 };
+   bool ok = GetClientRect(chain->wnd, &client) && ClientToScreen(chain->wnd, &origin);
+   int screen_w = GetSystemMetrics(SM_CXSCREEN);
+   int screen_h = GetSystemMetrics(SM_CYSCREEN);
+   if (old)
+      SetThreadDpiAwarenessContext(old);
+   if (!ok)
+      return false;
+   LONG w = client.right - client.left, h = client.bottom - client.top;
+   if (w != (LONG)chain->extent.width || h != (LONG)chain->extent.height ||
+       origin.x < 0 || origin.y < 0 ||
+       origin.x + w > screen_w || origin.y + h > screen_h)
+      return false;
+   *x = origin.x;
+   *y = origin.y;
+   return true;
+}

 #include "util/u_atomic.h"
+
+#if DETECT_OS_WINDOWS
+#include <windows.h>
+typedef int pid_t;
+/* No sync_file on Windows: nothing hands this driver a sync fd there. */
+static inline int sync_wait(int fd, int timeout)
+{
+   (void)fd;
+   (void)timeout;
+   return -1;
+}
+static inline bool sync_valid_fd(int fd)

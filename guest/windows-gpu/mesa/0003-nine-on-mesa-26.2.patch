diff --git a/src/gallium/frontends/nine/nine_win32.h b/src/gallium/frontends/nine/nine_win32.h
new file mode 100644
index 00000000..d6c6ad35
--- /dev/null
+++ b/src/gallium/frontends/nine/nine_win32.h
@@ -0,0 +1,71 @@
+/*
+ * Copyright © 2026 Entangled Desktop contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Nine was written for Linux (under wine) and uses pthreads for its few
+ * locks and its one worker thread. On Windows the same calls are spelled
+ * with Mesa's C11 threads, which is all this header does.
+ */
+#ifndef _NINE_WIN32_H_
+#define _NINE_WIN32_H_
+
+#ifdef _WIN32
+
+#include "c11/threads.h"
+
+typedef mtx_t pthread_mutex_t;
+typedef cnd_t pthread_cond_t;
+typedef thrd_t pthread_t;
+
+#define pthread_mutex_init(m, attr) mtx_init((m), mtx_plain)
+#define pthread_mutex_destroy(m) mtx_destroy(m)
+#define pthread_mutex_lock(m) mtx_lock(m)
+#define pthread_mutex_unlock(m) mtx_unlock(m)
+#define pthread_cond_init(c, attr) cnd_init(c)
+#define pthread_cond_destroy(c) cnd_destroy(c)
+#define pthread_cond_wait(c, m) cnd_wait((c), (m))
+#define pthread_cond_signal(c) cnd_signal(c)
+#define pthread_cond_broadcast(c) cnd_broadcast(c)
+#define pthread_join(t, result) thrd_join((t), NULL)
+
+/* A pthread's function returns a pointer and a C11 thread's an int: the one
+ * place Nine starts a thread (threadpool.c) goes through this. */
+struct nine_win32_thread_start {
+   void *(*function)(void *);
+   void *data;
+};
+
+static inline int
+nine_win32_thread_entry(void *arg)
+{
+   struct nine_win32_thread_start start = *(struct nine_win32_thread_start *)arg;
+
+   free(arg);
+   start.function(start.data);
+   return 0;
+}
+
+static inline int
+pthread_create(pthread_t *thread, void *attr, void *(*function)(void *), void *data)
+{
+   struct nine_win32_thread_start *start = malloc(sizeof *start);
+
+   (void)attr;
+   if (!start)
+      return -1;
+   start->function = function;
+   start->data = data;
+   if (thrd_create(thread, nine_win32_thread_entry, start) != thrd_success) {
+      free(start);
+      return -1;
+   }
+   return 0;
+}
+
+#else
+
+#include <pthread.h>
+
+#endif
+
+#endif /* _NINE_WIN32_H_ */

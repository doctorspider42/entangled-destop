+static void
+nine_ff_upload_constants(struct nine_context *context, struct pipe_constant_buffer *slot,
+                         const void *data, unsigned size)
+{
+    struct pipe_constant_buffer cb;
+
+    /* Into a real buffer, as the constants of a program's shaders go: a
+     * driver need not take a user buffer (Zink in Mesa 26.2 reads nothing
+     * right out of one). */
+    cb.buffer = NULL;
+    cb.buffer_offset = 0;
+    cb.buffer_size = size;
+    cb.user_buffer = NULL;
+    u_upload_data_ref(context->pipe->const_uploader, 0, size, 256, data,
+                      &cb.buffer_offset, &cb.buffer);
+    u_upload_unmap(context->pipe->const_uploader);
+
+    pipe_resource_reference(&slot->buffer, NULL);
+    *slot = cb;
+}

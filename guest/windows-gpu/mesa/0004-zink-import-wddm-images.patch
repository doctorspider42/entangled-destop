+#include <vulkan/vulkan_core.h>
+
+VkDevice
+zink_entangled_device(struct pipe_screen *screen);
+
+enum zink_entangled_copy {
+   ZINK_ENTANGLED_IMPORT,
+   ZINK_ENTANGLED_FIRST_EXPORT,
+   ZINK_ENTANGLED_EXPORT,
+};
+
+/* The shared image must remain valid through this batch's fence. */
+bool
+zink_entangled_copy_frame(struct pipe_context *pctx, struct pipe_resource *ptex,
+                         VkImage shared, enum zink_entangled_copy mode);
 #endif
+#endif

diff --git a/src/gallium/drivers/zink/zink_context.c b/src/gallium/drivers/zink/zink_context.c
--- a/src/gallium/drivers/zink/zink_context.c
+++ b/src/gallium/drivers/zink/zink_context.c
@@ -31,4 +31,5 @@
 #include "zink_inlines.h"
 #include "zink_kopper.h"
 #include "zink_program.h"
+#include "zink_public.h"
 #include "zink_query.h"
@@ -4783,3 +4784,96 @@
+#ifdef _WIN32
+VkDevice
+zink_entangled_device(struct pipe_screen *pscreen)
+{
+   struct zink_screen *screen = zink_screen(pscreen);
+   return screen->info.driver_props.driverID == VK_DRIVER_ID_MESA_VENUS
+      ? screen->dev : VK_NULL_HANDLE;
+}
+
+bool
+zink_entangled_copy_frame(struct pipe_context *pctx, struct pipe_resource *ptex,
+                         VkImage shared, enum zink_entangled_copy mode)
+{
+   struct zink_context *ctx = zink_context(pctx);
+   struct zink_screen *screen = zink_screen(pctx->screen);
+   struct zink_resource *tex = zink_resource(ptex);
+   const bool importing = mode == ZINK_ENTANGLED_IMPORT;
+   const bool first_export = mode == ZINK_ENTANGLED_FIRST_EXPORT;
+
+   if (ptex->target != PIPE_TEXTURE_2D || ptex->last_level ||
+       ptex->array_size != 1 || ptex->nr_samples > 1 ||
+       (tex->format != VK_FORMAT_B8G8R8A8_UNORM &&
+        tex->format != VK_FORMAT_B8G8R8A8_SRGB))
+      return false;
+
+   /* The EXTERNAL barriers and the copy run in the same ordered buffer. */
+   const bool no_reorder = ctx->no_reorder;
+   ctx->no_reorder = true;
+   if (importing)
+      zink_fb_clears_discard(ctx, ptex);
+   else
+      zink_fb_clears_apply(ctx, ptex, 0, 1);
+   zink_batch_no_rp(ctx);
+   const VkImageLayout shared_layout = importing ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
+                                                : VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+   const VkAccessFlags shared_access = importing ? VK_ACCESS_TRANSFER_READ_BIT
+                                                 : VK_ACCESS_TRANSFER_WRITE_BIT;
+   const VkImageLayout layout = screen->driver_workarounds.general_layout
+      ? VK_IMAGE_LAYOUT_GENERAL
+      : importing ? VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL : VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+   const VkAccessFlags local_access = importing ? VK_ACCESS_TRANSFER_WRITE_BIT
+                                                : VK_ACCESS_TRANSFER_READ_BIT;
+   screen->image_barrier(ctx, tex, layout, local_access,
+                         VK_PIPELINE_STAGE_TRANSFER_BIT);
+   VkCommandBuffer cmd = zink_get_cmdbuf(ctx, importing ? NULL : tex, importing ? tex : NULL);
+   zink_batch_reference_resource_rw(ctx, tex, importing);
+
+   const VkImageMemoryBarrier acquire = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .dstAccessMask = shared_access,
+      .oldLayout = first_export ? VK_IMAGE_LAYOUT_UNDEFINED : VK_IMAGE_LAYOUT_GENERAL,
+      .newLayout = shared_layout,
+      .srcQueueFamilyIndex = first_export ? VK_QUEUE_FAMILY_IGNORED : VK_QUEUE_FAMILY_EXTERNAL,
+      .dstQueueFamilyIndex = first_export ? VK_QUEUE_FAMILY_IGNORED : screen->gfx_queue,
+      .image = shared,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+   };
+   VKCTX(CmdPipelineBarrier)(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                             VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             0, 0, NULL, 0, NULL, 1, &acquire);
+   const VkImageCopy region = {
+      .srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+      .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+      .extent = {ptex->width0, ptex->height0, 1},
+   };
+   if (importing)
+      VKCTX(CmdCopyImage)(cmd, shared, shared_layout, tex->obj->image, tex->layout, 1, &region);
+   else
+      VKCTX(CmdCopyImage)(cmd, tex->obj->image, tex->layout, shared, shared_layout, 1, &region);
+
+   VkImageMemoryBarrier release = acquire;
+   release.srcAccessMask = shared_access;
+   release.dstAccessMask = 0;
+   release.oldLayout = shared_layout;
+   release.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+   release.srcQueueFamilyIndex = screen->gfx_queue;
+   release.dstQueueFamilyIndex = VK_QUEUE_FAMILY_EXTERNAL;
+   VKCTX(CmdPipelineBarrier)(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                             0, 0, NULL, 0, NULL, 1, &release);
+
+   zink_resource_disable_unordered(tex, importing);
+   if (importing && tex->fb_bind_count)
+      ctx->rp_tc_info_updated = true;
+   if (importing && ctx->track_renderpasses) {
+      ctx->needs_transfer_sync = true;
+      tex->obj->transfer_rp = ctx->rp_counter;
+   }
+   ctx->no_reorder = no_reorder;
+   return true;
+}
+#endif
+
 void
 zink_flush_memory_barrier(struct zink_context *ctx)
 {
diff --git a/src/gallium/drivers/zink/zink_public.h b/src/gallium/drivers/zink/zink_public.h

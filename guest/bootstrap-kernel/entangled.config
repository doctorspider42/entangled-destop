# Entangled Desktop bootstrap-kernel config fragment (backlog MVP-1101).
# Applied on top of `make defconfig kvm_guest.config`. Everything the guest
# needs before switch_root is BUILT IN — the bootstrap initramfs loads no
# modules.

# virtio transports. Both are built in: `transport` in a VM profile picks one
# per VM, and the guest kernel has to be able to serve either.
#
#   mmio — devices announced on the kernel command line, nothing enumerates.
#   pci  — the guest walks the bus (EPIC 19). Also the only transport a UEFI
#          firmware can use: EDK2's CloudHv build ships VirtioPciDeviceDxe and
#          no virtio-MMIO driver at all (ADR-0003).
#
# CONFIG_VIRTIO_PCI and CONFIG_PCI already come from `kvm_guest.config` and
# `defconfig`; they are listed here anyway so the fragment states the whole
# contract, and `build.sh` fails the build if either stops being built in.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y

# devices
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_INPUT=y

# input handlers. `evdev` comes from defconfig and is listed here because the
# fragment states the whole contract; `joydev` does not, and it is the half
# that decides whether the gamepad (GAME-2104) is a *joystick* to userspace.
# Without it the pad still appears as /dev/input/event*, SDL still finds it —
# and /dev/input/js* does not exist, which is what the older games, the
# `jstest` in every controller how-to, and the boot-test acceptance all look
# for. Built in, because this kernel loads no modules.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# serial console. DETECT_IRQ must stay OFF: IRQ autoprobing needs UART
# loopback mode, which vm-superio does not emulate — probing yields irq=0
# and interrupt-driven TX stalls. The static ISA table (ttyS0 = irq 4) is
# exactly what the Entangled Desktop machine provides.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DETECT_IRQ=n
CONFIG_SERIAL_8250_EXTENDED=n

# no netconsole noise on this machine
CONFIG_NETCONSOLE=n

# root filesystem support for the installed Debian
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# early userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# keep the image lean and the surface small
CONFIG_MODULES=n
CONFIG_DRM_BOCHS=n
CONFIG_DRM_CIRRUS_QEMU=n
CONFIG_DRM_QXL=n
